APP_ENV=development
DATABASE_URL=postgresql+psycopg://bi_platform:change-me@localhost:5432/bi_platform
SESSION_SECRET=replace-with-at-least-32-random-characters
FRONTEND_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
SESSION_TTL_HOURS=168
DATA_SOURCE_ENCRYPTION_KEY=
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
DATA_SOURCE_ALLOWED_HOSTS=
DATA_SOURCE_ALLOWED_CIDRS=
# Compose-only dev exception: use the bridge subnet shown by `docker network inspect`.
DATA_SOURCE_COMPOSE_DB_CIDR=172.16.0.0/12
DATA_SOURCE_ALLOW_PRIVATE_NETWORKS=false
DATA_SOURCE_ALLOW_LOCALHOST=false
DATA_SOURCE_CONNECT_TIMEOUT_SECONDS=5
DATA_SOURCE_QUERY_TIMEOUT_SECONDS=5
DATA_SOURCE_TLS_MODE=verify-full
DATA_SOURCE_MAX_TABLES=200
DATA_SOURCE_MAX_COLUMNS=2000
DATA_SOURCE_MAX_CONCURRENT_JOBS=4
UPLOAD_MAX_BYTES=25000000
UPLOAD_MAX_ROWS=50000
UPLOAD_MAX_COLUMNS=500
UPLOAD_PREVIEW_ROWS=50
